OPENAI_API_KEY=
ELEVENLABS_API_KEY=
# 폰/태블릿이 접근하는 서버 주소 (노트북 IP 또는 배포 주소)
PUBLIC_BASE_URL=http://192.168.0.10:8000
# STT 모델 (기본 gpt-4o-mini-transcribe)
STT_MODEL=gpt-4o-mini-transcribe
# LLM — Lablup Token Factory (Anthropic 호환). 토큰은 DM 으로 공유
ANTHROPIC_BASE_URL=https://api.console.lablup.ai/anthropic
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_MODEL=DeepSeek-V4.1-Flash-B300
# TTS — Fish Audio (무료 s2.1-pro-free, 목소리 복제). https://fish.audio 에서 API 키 발급
FISH_API_KEY=
FISH_TTS_MODEL=s2.1-pro-free

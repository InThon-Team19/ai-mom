OPENAI_API_KEY=
ELEVENLABS_API_KEY=
# 파일 URL 고정 주소 (비우면 요청이 들어온 주소를 자동 사용 — 보통 비워 두기)
PUBLIC_BASE_URL=
# LLM — Lablup Token Factory (Anthropic 호환). 토큰은 DM 으로 공유
ANTHROPIC_BASE_URL=https://api.console.lablup.ai/anthropic
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_MODEL=DeepSeek-V4.1-Flash-B300
# TTS — Fish Audio (무료 s2.1-pro-free, 목소리 복제). https://fish.audio 에서 API 키 발급
FISH_API_KEY=
FISH_TTS_MODEL=s2.1-pro-free
# STT — Groq 무료(카드 불필요, https://console.groq.com) 권장. 없으면 OPENAI_API_KEY(유료 선불) 사용
GROQ_API_KEY=
# 기본 DB는 server/aibom.db. 다른 경로/DB를 쓰는 경우에만 지정
# DB_URL=sqlite:///./aibom.db
# 기존 미디어 /voice /vision /activity 경로 활성화 (인증/소유권 검사는 항상 적용)
ALLOW_LEGACY_API=false
# Supabase Dashboard > Connect > Session pooler URI. Keep this server-side.
# URL-encode special characters in the database password.
# DB_URL overrides SUPABASE_DB_URL when both are set.
SUPABASE_DB_URL=
# Example: postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require
CORS_ORIGINS=http://localhost:8081,http://localhost:19006
# Production uses HTTPS. Only local HTTP development should set this to false.
SESSION_COOKIE_SECURE=true
# New/signup passwords. Existing passwords can still be used to log in.
PASSWORD_MIN_LENGTH=8
